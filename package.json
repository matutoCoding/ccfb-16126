{
  "name": "ear-shell-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "smoke:ui": "npm run build && node scripts/ui-smoke.mjs",
    "verify:browser": "npm run build && node scripts/browser-verify.mjs"
  },
  "devDependencies": {
    "playwright": "^1.48.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.5"
  }
}
